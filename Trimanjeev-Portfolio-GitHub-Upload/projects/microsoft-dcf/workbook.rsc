ress":"L63","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A64","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B64","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C64","text":"Balance-sheet inputs are dated 30 June 2025. No July cash, debt, investment or share-count roll-forward is assumed.","formula":"","bold":false,"fg":"#202934"},{"address":"D64","text":"","formula":"","bold":false},{"address":"E64","text":"","formula":"","bold":false},{"address":"F64","text":"","formula":"","bold":false},{"address":"G64","text":"","formula":"","bold":false},{"address":"H64","text":"","formula":"","bold":false},{"address":"I64","text":"","formula":"","bold":false},{"address":"J64","text":"","formula":"","bold":false},{"address":"K64","text":"","formula":"","bold":false},{"address":"L64","text":"","formula":"","bold":false}],[{"address":"A65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"E65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"F65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"G65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"H65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"I65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"J65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"K65","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"L65","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A66","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B66","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C66","text":"PP&E payables are excluded from operating working capital. Lease liabilities are excluded from its operating-liability subtotal.","formula":"","bold":false,"fg":"#202934"},{"address":"D66","text":"","formula":"","bold":false},{"address":"E66","text":"","formula":"","bold":false},{"address":"F66","text":"","formula":"","bold":false},{"address":"G66","text":"","formula":"","bold":false},{"address":"H66","text":"","formula":"","bold":false},{"address":"I66","text":"","formula":"","bold":false},{"address":"J66","text":"","formula":"","bold":false},{"address":"K66","text":"","formula":"","bold":false},{"address":"L66","text":"","formula":"","bold":false}],[{"address":"A67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"E67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"F67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"G67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"H67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"I67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"J67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"K67","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"L67","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A68","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B68","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C68","text":"Equity investments enter the equity bridge at carrying value, without a separate revaluation of OpenAI or other holdings.","formula":"","bold":false,"fg":"#202934"},{"address":"D68","text":"","formula":"","bold":false},{"address":"E68","text":"","formula":"","bold":false},{"address":"F68","text":"","formula":"","bold":false},{"address":"G68","text":"","formula":"","bold":false},{"address":"H68","text":"","formula":"","bold":false},{"address":"I68","text":"","formula":"","bold":false},{"address":"J68","text":"","formula":"","bold":false},{"address":"K68","text":"","formula":"","bold":false},{"address":"L68","text":"","formula":"","bold":false}]]},{"name":"Methodology","columns":["A","B","C","D"],"rows":[[{"address":"A1","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B1","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C1","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D1","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A2","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B2","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C2","text":"Methodology and scope","formula":"","bold":true,"fg":"#233D5B"},{"address":"D2","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A3","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B3","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C3","text":"Independent equity valuation case. Prepared by Trimanjeev Sawhney.","formula":"","bold":false,"fg":"#687585"},{"address":"D3","text":"","formula":"","bold":false}],[{"address":"A4","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B4","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C4","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D4","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A5","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B5","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C5","text":"Selected case","formula":"","bold":false,"fg":"#202934"},{"address":"D5","text":"Base","formula":"='Assumptions'!E5","bold":false,"fg":"#008000"}],[{"address":"A6","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B6","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C6","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D6","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A7","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B7","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C7","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D7","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A8","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B8","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C8","text":"Research date","formula":"","bold":true,"fg":"#202934"},{"address":"D8","text":"Historical valuation as of 31 July 2025 using FY2025 results and June balance-sheet values. It is not a current price target.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A9","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B9","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C9","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D9","text":"","formula":"","bold":false}],[{"address":"A10","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B10","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C10","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D10","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A11","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B11","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C11","text":"Operating forecast","formula":"","bold":true,"fg":"#202934"},{"address":"D11","text":"Five annual revenue-growth and operating-margin assumptions determine EBIT. Tax rates are estimates. Forecasts are consolidated rather than product-level.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A12","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B12","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C12","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D12","text":"","formula":"","bold":false}],[{"address":"A13","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B13","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C13","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D13","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A14","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B14","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C14","text":"Capital investment","formula":"","bold":true,"fg":"#202934"},{"address":"D14","text":"Cash capex plus new finance-lease assets fund the PP&E schedule. Future changes in PP&E payables, disposals, impairments and acquisitions are assumed zero.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A15","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B15","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C15","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D15","text":"","formula":"","bold":false}],[{"address":"A16","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B16","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C16","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D16","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A17","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B17","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C17","text":"Depreciation","formula":"","bold":true,"fg":"#202934"},{"address":"D17","text":"Opening PP&E depreciates over an estimated six-year remaining life. New assets use an eight-year life and a half-year convention. New-asset life must remain at least five years.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A18","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B18","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C18","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D18","text":"","formula":"","bold":false}],[{"address":"A19","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B19","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C19","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D19","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A20","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B20","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C20","text":"Working capital","formula":"","bold":true,"fg":"#202934"},{"address":"D20","text":"Receivables + inventory + other current assets, less AP excluding PP&E purchases, accrued pay, current deferred revenue and other current liabilities excluding lease debt. Separately reported tax liabilities and cash are excluded.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A21","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B21","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C21","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D21","text":"","formula":"","bold":false}],[{"address":"A22","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B22","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C22","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D22","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A23","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B23","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C23","text":"Stock compensation","formula":"","bold":true,"fg":"#202934"},{"address":"D23","text":"SBC remains an economic expense in operating margin. No add-back is made. The period-end share count is held fixed, with no assumed buyback benefit.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A24","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B24","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C24","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D24","text":"","formula":"","bold":false}],[{"address":"A25","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B25","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C25","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D25","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A26","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B26","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C26","text":"Capital cost","formula":"","bold":true,"fg":"#202934"},{"address":"D26","text":"CAPM cost of equity = assumed risk-free rate + beta x equity premium. Market equity value and carrying debt plus finance leases set capital weights. A case adjustment changes WACC.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A27","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B27","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C27","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D27","text":"","formula":"","bold":false}],[{"address":"A28","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B28","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C28","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D28","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A29","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B29","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C29","text":"Terminal value","formula":"","bold":true,"fg":"#202934"},{"address":"D29","text":"Terminal NOPAT grows at g. Reinvestment = NOPAT x g / ROIC. Terminal FCF = NOPAT less reinvestment. WACC must exceed g; terminal ROIC must exceed g.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A30","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B30","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C30","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D30","text":"","formula":"","bold":false}],[{"address":"A31","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B31","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C31","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D31","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A32","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B32","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C32","text":"Equity bridge","formula":"","bold":true,"fg":"#202934"},{"address":"D32","text":"Add cash, short-term investments and equity investments to enterprise value. Subtract debt and finance leases. Operating leases stay in operating costs and are not deducted again.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A33","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B33","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C33","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D33","text":"","formula":"","bold":false}],[{"address":"A34","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B34","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C34","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D34","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A35","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B35","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C35","text":"Timing","formula":"","bold":true,"fg":"#202934"},{"address":"D35","text":"Fiscal year-end discounting uses actual days / 365 from 31 July 2025. FY2026 cash flow is prorated to 334/365 of the annual total. July balance-sheet changes are not modeled.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A36","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B36","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C36","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D36","text":"","formula":"","bold":false}],[{"address":"A37","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B37","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C37","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D37","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A38","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B38","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C38","text":"Model limits","formula":"","bold":true,"fg":"#202934"},{"address":"D38","text":"No segment forecast, option valuation, contingent-liability adjustment, asset-sale tax, investment revaluation or capitalized R&D. Simplified lives and a short explicit horizon affect terminal dependence.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A39","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B39","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C39","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D39","text":"","formula":"","bold":false}],[{"address":"A40","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B40","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C40","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D40","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A41","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B41","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C41","text":"Using the files","formula":"","bold":true,"fg":"#202934"},{"address":"D41","text":"Start with Summary, edit yellow case assumptions, then review DCF and Sensitivity. The report is a static snapshot and must be refreshed after workbook edits.","formula":"","bold":false,"fg":"#202934"}],[{"address":"A42","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B42","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C42","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D42","text":"","formula":"","bold":false}],[{"address":"A43","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B43","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C43","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"D43","text":"","formula":"","bold":false,"fg":"#202934"}],[{"address":"A44","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"B44","text":"","formula":"","bold":false,"fg":"#202934"},{"address":"C44","text":"Input handling","formula":"","bold":true,"fg":"#202934"},{"address":"D44","text":"Blank selected assumptions and invalid valuation domains expose unavailable results. Zero is valid where economically meaningful. A blank unselected case does not block the active forecast.","formula":"","bold":false,"fg":"#202934"}]]}]}]]}]]
