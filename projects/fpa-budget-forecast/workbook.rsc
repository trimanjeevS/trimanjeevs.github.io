"C11","text":"Scope","formula":"","bold":true,"fg":"#1D2733"},{"address":"D11","text":"Calendar 2026. Jan-Jun simulated actuals. Jul-Dec forecast. CAD, accrual revenue and expenses, positive cost presentation.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A12","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B12","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C12","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D12","text":"","formula":"","bold":false}],[{"address":"A13","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B13","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C13","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D13","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A14","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B14","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C14","text":"Data","formula":"","bold":true,"fg":"#1D2733"},{"address":"D14","text":"36 monthly product/channel records and six operating-expense records. Essentials, Standard and Premium products sell through Wholesale and Online.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A15","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B15","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C15","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D15","text":"","formula":"","bold":false}],[{"address":"A16","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B16","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C16","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D16","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A17","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B17","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C17","text":"What is simulated","formula":"","bold":true,"fg":"#1D2733"},{"address":"D17","text":"All transactions, unit prices, supplier costs, staffing costs and targets were generated for this case. Northline Trading is fictional.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A18","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B18","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C18","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D18","text":"","formula":"","bold":false}],[{"address":"A19","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B19","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C19","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D19","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A20","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B20","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C20","text":"How the model works","formula":"","bold":true,"fg":"#1D2733"},{"address":"D20","text":"Budget units x net price = revenue. Units x unit cost = COGS. Revenue - COGS = gross profit. Gross profit - operating expenses = EBITDA.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A21","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B21","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C21","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D21","text":"","formula":"","bold":false}],[{"address":"A22","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B22","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C22","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D22","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A23","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B23","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C23","text":"Operating expenses","formula":"","bold":true,"fg":"#1D2733"},{"address":"D23","text":"Payroll = paid FTE x annual pay / 12 x (1 + employer load). Fulfilment = channel units x delivery rate. Marketing = online revenue x spend rate. Historical annualized pay includes overtime.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A24","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B24","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C24","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D24","text":"","formula":"","bold":false}],[{"address":"A25","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B25","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C25","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D25","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A26","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B26","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C26","text":"Forecast controls","formula":"","bold":true,"fg":"#1D2733"},{"address":"D26","text":"Change Assumptions!D5 to 1 Base, 2 Upside or 3 Downside. Edit yellow case inputs in Jul-Dec. Active rows feed the same forecast; historical actuals do not change.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A27","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B27","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C27","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D27","text":"","formula":"","bold":false}],[{"address":"A28","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B28","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C28","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D28","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A29","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B29","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C29","text":"Budget protection","formula":"","bold":true,"fg":"#1D2733"},{"address":"D29","text":"Original budget drivers are blue but should remain fixed for performance reporting. Save a separate planning version before deliberately changing the baseline.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A30","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B30","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C30","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D30","text":"","formula":"","bold":false}],[{"address":"A31","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B31","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C31","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D31","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A32","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B32","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C32","text":"Variance method","formula":"","bold":true,"fg":"#1D2733"},{"address":"D32","text":"Actual - budget for each matching month. A positive revenue/profit variance is favorable. A positive cost variance is unfavorable. Margin differences are percentage points.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A33","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B33","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C33","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D33","text":"","formula":"","bold":false}],[{"address":"A34","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B34","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C34","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D34","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A35","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B35","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C35","text":"Profit explanation","formula":"","bold":true,"fg":"#1D2733"},{"address":"D35","text":"By channel: volume effect = (actual units - budget units) x budget unit margin. Price effect = actual units x price change. Cost effect = -actual units x unit-cost change.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A36","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B36","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C36","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D36","text":"","formula":"","bold":false}],[{"address":"A37","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B37","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C37","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D37","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A38","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B38","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C38","text":"Mix and precision","formula":"","bold":true,"fg":"#1D2733"},{"address":"D38","text":"Price and unit-cost effects include changes in the mix of products within each channel. The bridge uses unrounded weighted prices so it reconciles exactly.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A39","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B39","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C39","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D39","text":"","formula":"","bold":false}],[{"address":"A40","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B40","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C40","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D40","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A41","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B41","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C41","text":"Case assumptions","formula":"","bold":true,"fg":"#1D2733"},{"address":"D41","text":"Forecast volume, price and unit-cost factors multiply each month's budget. 100% means unchanged. Marketing is an absolute share of online revenue.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A42","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B42","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C42","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D42","text":"","formula":"","bold":false}],[{"address":"A43","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B43","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C43","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D43","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A44","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B44","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C44","text":"Limits","formula":"","bold":true,"fg":"#1D2733"},{"address":"D44","text":"This is an EBITDA operating model, not a cash-flow, balance-sheet or valuation model. It excludes tax, interest, depreciation, capex, inventory and receivables schedules.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A45","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B45","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C45","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D45","text":"","formula":"","bold":false}],[{"address":"A46","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B46","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C46","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D46","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A47","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B47","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C47","text":"Refresh","formula":"","bold":true,"fg":"#1D2733"},{"address":"D47","text":"Actuals use fixed Jan-Jun ranges and 36 product/channel records. To add a new actual month, extend the source ranges and update the forecast boundary consistently. It is not an automated refresh.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A48","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B48","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C48","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D48","text":"","formula":"","bold":false}],[{"address":"A49","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B49","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C49","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D49","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A50","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B50","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C50","text":"Source completeness","formula":"","bold":true,"fg":"#1D2733"},{"address":"D50","text":"The model requires three unique product records per channel/month and one complete expense record per month. Missing, duplicate or inconsistent source records make affected results unavailable.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A51","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B51","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C51","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D51","text":"","formula":"","bold":false}],[{"address":"A52","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B52","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C52","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D52","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A53","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B53","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C53","text":"Input conventions","formula":"","bold":true,"fg":"#1D2733"},{"address":"D53","text":"Blue numbers are inputs. Yellow cells are forecast controls. Green formulas link across sheets. Costs are positive. Zero is allowed, while a blank or negative selected driver returns #N/A.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A54","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B54","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C54","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D54","text":"","formula":"","bold":false}],[{"address":"A55","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B55","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C55","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D55","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A56","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B56","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C56","text":"Cost normalization","formula":"","bold":true,"fg":"#1D2733"},{"address":"D56","text":"Jul-Dec payroll and fulfilment unit rates return to budget in every case. The scenarios do not continue H1 overtime or higher delivery rates. Forecast margin recovery depends partly on this assumption.","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A57","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B57","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C57","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D57","text":"","formula":"","bold":false}],[{"address":"A58","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B58","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C58","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"D58","text":"","formula":"","bold":false,"fg":"#1D2733"}],[{"address":"A59","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"B59","text":"","formula":"","bold":false,"fg":"#1D2733"},{"address":"C59","text":"Sharing and versions","formula":"","bold":true,"fg":"#1D2733"},{"address":"D59","text":"The PDF brief summarizes the supplied assumptions. It does not update when the workbook changes. Save a dated copy for revisions and refresh the brief before sharing updated results.","formula":"","bold":false,"fg":"#1D2733"}]]}]}]]}]]
